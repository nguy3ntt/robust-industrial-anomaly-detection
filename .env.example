# Local paths for the audited Windows workstation. Copy this file to .env and
# change the paths when using another machine. The application will never put
# datasets, caches, or model weights under version control.
DEEPFAKE_DATA_ROOT=D:/deepfake-data
DEEPFAKE_ARTIFACT_ROOT=D:/deepfake-artifacts
TORCH_HOME=D:/deepfake-cache/torch
HF_HOME=D:/deepfake-cache/huggingface
