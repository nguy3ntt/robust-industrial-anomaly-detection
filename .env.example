# Local paths for the audited Windows workstation. Copy this file to .env and
# change the paths when using another machine. Datasets, caches, and model
# weights must remain outside version control.
ANOMALY_DATA_ROOT=D:/industrial-anomaly-data
ANOMALY_ARTIFACT_ROOT=D:/industrial-anomaly-artifacts
TORCH_HOME=D:/industrial-anomaly-cache/torch
HF_HOME=D:/industrial-anomaly-cache/huggingface
